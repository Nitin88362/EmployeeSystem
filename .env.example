# ========================================
# EDITONE HRMS - Environment Variables
# Copy this to .env and update with your values
# ========================================

# Server Port
PORT=3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgresql_password_here
DB_NAME=editone_hrms

# JWT Secret (CHANGE THIS to a long random string in production!)
JWT_SECRET=editone-secret-key-change-this-to-random-string-in-production-2026

# JWT Token expiry
JWT_EXPIRY=7d

# Default admin credentials (used on first run if admin table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Dr. Pankaj Jagya
ADMIN_EMAIL=admin@editone.in
